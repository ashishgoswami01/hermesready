# ---------------------------------------------------------------------------
# Hermes Control Center — server-side environment
# Copy to .env.local for local dev; set the same keys in Vercel → Settings →
# Environment Variables for the deployment. None of these are NEXT_PUBLIC_,
# so none of them reach the browser.
# ---------------------------------------------------------------------------

# Supabase project "hermes" — Dashboard → Settings → API
SUPABASE_URL=https://jvyxyajucqygywigyftt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google service account with read-only access to the knowledge-bank folder.
# Google Cloud → IAM → Service Accounts → Keys → Add key (JSON), then share the
# Drive folder with this email as Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The whole private_key value from that JSON, newlines written as \n, in quotes:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# HTTP Basic auth over /admin and /api. Leave ADMIN_PASSWORD empty only while
# testing — an open deployment exposes the sync trigger and the settings form.
ADMIN_USER=hermes
ADMIN_PASSWORD=

# Shared secret the scheduled refresh must present (Vercel Cron sends it
# automatically once it's set here).
CRON_SECRET=

# ---------------------------------------------------------------------------
# Set on the SUPABASE project, not here — Dashboard → Edge Functions → Secrets:
#   GEMINI_API_KEY   free key from https://aistudio.google.com/apikey
#   GEMINI_MODEL     optional, defaults to gemini-2.5-flash
# ---------------------------------------------------------------------------
